local FLICK_DURATION = 0.005
local MAX_DISTANCE = math.huge
local CLICK_INTERVAL = 0.12
local CLICK_HOLD_TIME = 0.01

-- ===== Aim mode settings =====
local aimMode = "Distance"   -- "Distance" = closest in world | "FOV" = closest to crosshair inside circle
local FOV_RADIUS = 100       -- FOV circle radius in pixels (FOV mode only)
local showFovCircle = false

local m2Held = false
local spamEnabled = false
local nextClickTime = 0

local function getClosestEnemy()
    local closestPlayer = nil
    local closestScore = math.huge
    local cameraPosition = Camera.CFrame.Position
    local screenCenter = Camera.ViewportSize / 2

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Team ~= LocalPlayer.Team then
            local character = player.Character
            if character then
                local head = character:FindFirstChild("Head")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if head and humanoid and humanoid.Health > 0 then
                    local headPosition = head.Position

                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
                    local raycastResult = Workspace:Raycast(cameraPosition, (headPosition - cameraPosition), raycastParams)
                    local clearLOS = not raycastResult or raycastResult.Instance:IsDescendantOf(character)

                    if clearLOS then
                        local score

                        if aimMode == "FOV" then
                            local screenPoint, onScreen = Camera:WorldToViewportPoint(headPosition)
                            if not onScreen then continue end

                            local distFromCenter = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                            if distFromCenter > FOV_RADIUS then continue end

                            score = distFromCenter -- closest to crosshair wins
                        else
                            local distance = (cameraPosition - headPosition).Magnitude
                            if distance > MAX_DISTANCE then continue end

                            score = distance -- closest in world wins
                        end

                        if score < closestScore then
                            closestScore = score
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

-- M1 Flick (original; triggers on manual + spam clicks)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 and workaing then
        local targetPlayer = getClosestEnemy()
        if targetPlayer then
            local originalCFrame = Camera.CFrame
            local headPosition = targetPlayer.Character.Head.Position
            
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, headPosition)
            
            task.spawn(function()
                task.wait(FLICK_DURATION)
                Camera.CFrame = originalCFrame
            end)
        end
    end
end)
